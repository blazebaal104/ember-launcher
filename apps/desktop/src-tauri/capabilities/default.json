{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions. HTTP is limited to the public content APIs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.modrinth.com/*" },
        { "url": "https://cdn.modrinth.com/*" }
      ]
    }
  ]
}
